<UserControl x:Class="StudentCounseling.Views.CounselingTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StudentCounseling.Converters"
             xmlns:m="clr-namespace:StudentCounseling.Models"
             xmlns:vm="clr-namespace:StudentCounseling.ViewModels"
             FontSize="13">
    <UserControl.Resources>
        <conv:EmptyCollectionToVisibilityConverter x:Key="EmptyToVis" ShowWhenEmpty="True"/>
        <conv:NullToVisibilityConverter x:Key="NotNullToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis" Invert="True"/>
        <conv:StringTruncateConverter x:Key="Truncate80" MaxLength="80"/>
        <conv:TagBrushConverter x:Key="TagBrush"/>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BadgeBackBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource BadgeTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: 개인/집단 목록 -->
        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="12,12,12,6">
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.ToolTip>이름으로 검색</TextBox.ToolTip>
                    </TextBox>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="학년" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" Margin="2,0,0,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="반" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" Margin="2,0,0,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="번호" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" Margin="2,0,0,2"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource InputBox}"
                                 Text="{Binding SearchGrade, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="학년"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource InputBox}"
                                 Text="{Binding SearchClassNumber, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="반"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource InputBox}"
                                 Text="{Binding SearchNumber, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="번호"/>
                    </Grid>
                </StackPanel>

                <TabControl Grid.Row="1" Margin="8,0,8,8"
                            SelectedIndex="{Binding SelectedListTabIndex}"
                            BorderThickness="0" Background="Transparent">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="개인"/>
                                <TextBlock Text=" (" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock Text="{Binding StudentCount, Mode=OneWay}" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock Text=")" Foreground="{StaticResource SubtleTextBrush}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="-8,8,-8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <ListBox ItemsSource="{Binding StudentsView}"
                                         SelectedItem="{Binding SelectedStudent}"
                                         BorderThickness="0" Background="Transparent"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="12,8"/>
                                            <Setter Property="Margin" Value="6,1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="b" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type m:Student}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                                <TextBlock Grid.Column="1" Foreground="{StaticResource SubtleTextBrush}" FontSize="11">
                                                    <Run Text="{Binding Grade, Mode=OneWay}"/><Run Text="-"/><Run Text="{Binding ClassNumber, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="+ 학생 추가 또는 엑셀 가져오기로 시작"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="20"
                                           Visibility="{Binding Main.Students, Converter={StaticResource EmptyToVis}}"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                                        Content="+ 학생 추가"
                                        Command="{Binding AddStudentCommand}"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="⋯"
                                        Click="MoreButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="엑셀로 가져오기" Command="{Binding ImportStudentsCommand}"/>
                                            <MenuItem Header="엑셀로 내보내기" Command="{Binding ExportStudentsCommand}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="집단"/>
                                <TextBlock Text=" (" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock Text="{Binding GroupCount, Mode=OneWay}" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock Text=")" Foreground="{StaticResource SubtleTextBrush}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="-8,8,-8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <ListBox ItemsSource="{Binding GroupItems}"
                                         SelectedItem="{Binding SelectedGroup}"
                                         BorderThickness="0" Background="Transparent"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="12,8"/>
                                            <Setter Property="Margin" Value="6,2"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="b" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GroupCounselingGroupViewModel}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding GroupName}"
                                                           FontWeight="Medium"/>
                                                <TextBlock Text="{Binding ParticipantNames}"
                                                           Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                <TextBlock Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                                    <Run Text="{Binding SessionCount, Mode=OneWay}"/><Run Text="건 · 최근 "/><Run Text="{Binding LatestDateLabel, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="+ 집단 만들기로 시작"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="20"
                                           Visibility="{Binding GroupItems, Converter={StaticResource EmptyToVis}}"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                                        Content="+ 집단 만들기"
                                        Command="{Binding AddGroupCommand}"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                        Content="편집"
                                        Command="{Binding EditGroupCommand}"/>
                                <Button Grid.Column="4" Style="{StaticResource GhostButton}"
                                        Content="삭제"
                                        Command="{Binding DeleteGroupCommand}"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- MIDDLE: 학생 헤더 + 상담 카드 -->
        <Grid Grid.Column="1">
            <TextBlock Text="좌측에서 학생을 선택해주세요"
                       Foreground="{StaticResource SubtleTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ActiveSelection, Converter={StaticResource NullToVis}}"/>

            <Grid Visibility="{Binding SelectedStudent, Converter={StaticResource NotNullToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="20,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedStudent.Name}" FontSize="15" FontWeight="Medium"/>
                            <TextBlock Text="{Binding SelectedStudentClassLabel}"
                                       Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding SelectedStudent.Memo}"
                                       Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding SelectedStudent.Memo, Converter={StaticResource NotNullToVis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource GhostButton}" Content="편집" Margin="0,0,6,0"
                                    Command="{Binding EditStudentCommand}"/>
                            <Button Style="{StaticResource GhostButton}" Content="삭제"
                                    Command="{Binding DeleteStudentCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="20,16,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" FontSize="11">
                        <Run Text="상담 내역 ("/><Run Text="{Binding CounselingCount, Mode=OneWay}"/><Run Text="건)"/>
                    </TextBlock>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                            Content="+ 새 상담"
                            Command="{Binding AddCounselingCommand}"/>
                </Grid>

                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding CounselingItems}"
                             SelectedItem="{Binding SelectedCounselingItem}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="Margin" Value="14,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="White"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CounselingItemViewModel}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Counseling.Date, StringFormat={}{0:yyyy-MM-dd}}"
                                                       FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Style="{StaticResource Badge}" Background="{Binding Counseling.Type, Converter={StaticResource TagBrush}}">
                                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Counseling.Type}"
                                                           Foreground="{Binding Counseling.Type, Converter={StaticResource TagBrush}, ConverterParameter=Foreground}"/>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="{Binding Counseling.SubCategory, Converter={StaticResource TagBrush}}">
                                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Counseling.SubCategory}"
                                                           Foreground="{Binding Counseling.SubCategory, Converter={StaticResource TagBrush}, ConverterParameter=Foreground}"/>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="{Binding Counseling.Method, Converter={StaticResource TagBrush}}">
                                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Counseling.Method}"
                                                           Foreground="{Binding Counseling.Method, Converter={StaticResource TagBrush}, ConverterParameter=Foreground}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeLabel}"
                                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding ContentFirstLine, Converter={StaticResource Truncate80}}"
                                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ParticipantNames}" Margin="0,3,0,0"
                                               Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsGroup, Converter={StaticResource NotNullToVis}}"/>
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                                               Visibility="{Binding HasNextDate, Converter={StaticResource NotNullToVis}}">
                                        <Run Text="다음: "/><Run Text="{Binding Counseling.NextDate, StringFormat={}{0:yyyy-MM-dd}, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="아직 상담 기록이 없어요"
                               Foreground="{StaticResource SubtleTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding CounselingItems, Converter={StaticResource EmptyToVis}}"/>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding SelectedGroup, Converter={StaticResource NotNullToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="20,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedGroup.GroupName}" FontSize="15" FontWeight="Medium"/>
                        <TextBlock Text="{Binding SelectedGroup.ParticipantNames}"
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="20,16,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" FontSize="11">
                        <Run Text="집단상담 내역 ("/><Run Text="{Binding CounselingCount, Mode=OneWay}"/><Run Text="건)"/>
                    </TextBlock>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                            Content="+ 집단상담"
                            Command="{Binding AddGroupCounselingCommand}"/>
                </Grid>

                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding CounselingItems}"
                             SelectedItem="{Binding SelectedCounselingItem}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="Margin" Value="14,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="White"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CounselingItemViewModel}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Counseling.Date, StringFormat={}{0:yyyy-MM-dd}}"
                                                       FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Style="{StaticResource Badge}" Background="{Binding Counseling.SubCategory, Converter={StaticResource TagBrush}}">
                                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Counseling.SubCategory}"
                                                           Foreground="{Binding Counseling.SubCategory, Converter={StaticResource TagBrush}, ConverterParameter=Foreground}"/>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="{Binding Counseling.Method, Converter={StaticResource TagBrush}}">
                                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Counseling.Method}"
                                                           Foreground="{Binding Counseling.Method, Converter={StaticResource TagBrush}, ConverterParameter=Foreground}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeLabel}"
                                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding ContentFirstLine, Converter={StaticResource Truncate80}}"
                                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="아직 상담 기록이 없어요"
                               Foreground="{StaticResource SubtleTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding CounselingItems, Converter={StaticResource EmptyToVis}}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- RIGHT: 상담 상세 -->
        <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <TextBlock Text="상담을 선택하면 자세히 볼 수 있어요"
                           Foreground="{StaticResource SubtleTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SelectedCounselingItem, Converter={StaticResource NullToVis}}"/>

                <Grid Visibility="{Binding SelectedCounselingItem, Converter={StaticResource NotNullToVis}}"
                      DataContext="{Binding SelectedCounselingItem}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,20,8">
                        <Border Style="{StaticResource Badge}" Background="{Binding Counseling.Type, Converter={StaticResource TagBrush}}">
                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Counseling.Type}"
                                       Foreground="{Binding Counseling.Type, Converter={StaticResource TagBrush}, ConverterParameter=Foreground}"/>
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="{Binding Counseling.SubCategory, Converter={StaticResource TagBrush}}">
                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Counseling.SubCategory}"
                                       Foreground="{Binding Counseling.SubCategory, Converter={StaticResource TagBrush}, ConverterParameter=Foreground}"/>
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="{Binding Counseling.Method, Converter={StaticResource TagBrush}}">
                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Counseling.Method}"
                                       Foreground="{Binding Counseling.Method, Converter={StaticResource TagBrush}, ConverterParameter=Foreground}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Margin="20,0,20,4"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="11">
                        <Run Text="{Binding Counseling.Date, StringFormat={}{0:yyyy-MM-dd}, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding TimeLabel, Mode=OneWay}"/>
                    </TextBlock>

                    <StackPanel Grid.Row="2" Margin="20,4,20,4"
                                Visibility="{Binding IsGroup, Converter={StaticResource NotNullToVis}}">
                        <TextBlock Text="{Binding GroupTitle}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding ParticipantNames}"
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Margin="20,4,20,12"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                               Visibility="{Binding HasNextDate, Converter={StaticResource NotNullToVis}}">
                        <Run Text="다음 예약: "/><Run Text="{Binding Counseling.NextDate, StringFormat={}{0:yyyy-MM-dd}, Mode=OneWay}"/>
                    </TextBlock>

                    <ScrollViewer Grid.Row="4" Margin="20,8,20,12" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding Counseling.Content}" TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <Border Grid.Row="5" Margin="20,0,20,12" Padding="12"
                            Background="{StaticResource HoverBrush}" CornerRadius="6"
                            Visibility="{Binding Counseling.FollowUp, Converter={StaticResource NotNullToVis}}">
                        <StackPanel>
                            <TextBlock Text="후속 조치" FontSize="11" FontWeight="Medium"
                                       Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Counseling.FollowUp}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,20">
                        <Button Style="{StaticResource GhostButton}" Content="편집" Margin="0,0,6,0"
                                Command="{Binding DataContext.EditCounselingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Button Style="{StaticResource GhostButton}" Content="삭제"
                                Command="{Binding DataContext.DeleteCounselingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
