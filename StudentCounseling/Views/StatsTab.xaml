<UserControl x:Class="StudentCounseling.Views.StatsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StudentCounseling.ViewModels"
             xmlns:conv="clr-namespace:StudentCounseling.Converters"
             FontSize="13">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NotNullToVis"/>
        <SolidColorBrush x:Key="StatBarBrush" Color="#93C5FD"/>
        <SolidColorBrush x:Key="StatBarBackBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TableHoverBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="TableSelectedBrush" Color="#F8FAFC"/>

        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style TargetType="ProgressBar" x:Key="QuietProgressBar">
            <Setter Property="Foreground" Value="{StaticResource StatBarBrush}"/>
            <Setter Property="Background" Value="{StaticResource StatBarBackBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" Height="{TemplateBinding Height}">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow" x:Key="QuietDataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TableHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource TableSelectedBrush}"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell" x:Key="QuietDataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader" x:Key="QuietDataGridHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Period filter row -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="기간" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Padding="8,6"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal"
                        Visibility="{Binding IsCustomRange, Converter={StaticResource NotNullToVis}}">
                <DatePicker SelectedDate="{Binding CustomStart}" Margin="0,0,6,0"/>
                <TextBlock Text="~" VerticalAlignment="Center" Margin="2,0"/>
                <DatePicker SelectedDate="{Binding CustomEnd}" Margin="6,0,0,0"/>
            </StackPanel>
            <Button Grid.Column="6" Style="{StaticResource PrimaryButton}"
                    Content="엑셀로 내보내기"
                    Command="{Binding ExportCounselingsCommand}"/>
        </Grid>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="총 상담 횟수" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                    <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="Medium" Margin="0,4,0,4"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource SubtleTextBrush}">
                        <Run Text="개인 "/><Run Text="{Binding IndividualCount, Mode=OneWay}"/>
                        <Run Text=" · 집단 "/><Run Text="{Binding GroupCount, Mode=OneWay}"/>
                        <Run Text=" · 학부모 "/><Run Text="{Binding ParentCount, Mode=OneWay}"/>
                        <Run Text=" · 심리검사 "/><Run Text="{Binding TestCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="상담 받은 학생 수" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                    <TextBlock Text="{Binding UniqueStudentCount}" FontSize="22" FontWeight="Medium" Margin="0,4,0,4"/>
                    <TextBlock Text="(중복 제거)" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="집단상담 횟수" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                    <TextBlock Text="{Binding GroupSessionCount}" FontSize="22" FontWeight="Medium" Margin="0,4,0,4"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="다음 예약 건수" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                    <TextBlock Text="{Binding UpcomingCount}" FontSize="22" FontWeight="Medium" Margin="0,4,0,4"/>
                    <TextBlock Text="(오늘 이후)" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main 2-column body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: categories grouped by Type -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CategorySections}" Margin="14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TypeSection}">
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{Binding TypeName}" FontWeight="Medium" FontSize="14" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CategoryStat}">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}"
                                                                 Minimum="0" Maximum="100"
                                                                 Style="{StaticResource QuietProgressBar}"
                                                                 Margin="8,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Count}" TextAlignment="Right" FontWeight="Medium"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: top students -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="학생별 상담 횟수" FontWeight="Medium" FontSize="14" Margin="14,14,14,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TopStudents}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              RowStyle="{StaticResource QuietDataGridRow}"
                              CellStyle="{StaticResource QuietDataGridCell}"
                              ColumnHeaderStyle="{StaticResource QuietDataGridHeader}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="학년-반" Binding="{Binding ClassLabel}" Width="80"/>
                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="횟수" Binding="{Binding Count}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Method distribution -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="상담 방법별 분포" FontWeight="Medium" FontSize="14" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding MethodStats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MethodStat}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Method}" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}"
                                             Minimum="0" Maximum="100"
                                             Style="{StaticResource QuietProgressBar}"
                                             Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Count}" TextAlignment="Right" FontWeight="Medium"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
